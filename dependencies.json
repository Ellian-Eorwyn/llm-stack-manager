{
  "version": 1,
  "dependencies": [
    {
      "name": "llama.cpp",
      "type": "git-cmake",
      "repo": "https://github.com/ggml-org/llama.cpp.git",
      "ref": "620d2225cc436ab0b001e3200e590e3b286ef9ab",
      "path": "deps/llama.cpp",
      "patches": [
        "patches/llama.cpp/0001-an-implied-object-schema-leaves-a-grammar-alone.patch"
      ],
      "build_dir": "deps/llama.cpp/build",
      "target": "llama-server",
      "binary": "deps/llama.cpp/build/bin/llama-server",
      "cmake_args": [
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "require_gpu": true
    },
    {
      "name": "llama.cpp-next",
      "type": "git-cmake",
      "repo": "https://github.com/ggml-org/llama.cpp.git",
      "ref": "66e665c4276ee46f3ec9872dd7e5a496842bc44f",
      "path": "deps/llama.cpp-next",
      "build_dir": "deps/llama.cpp-next/build",
      "target": "llama-server",
      "binary": "deps/llama.cpp-next/build/bin/llama-server",
      "cmake_args": [
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "require_gpu": true,
      "enabled_env": "LLAMACPP_NEXT_ENABLED"
    },
    {
      "name": "llama.cpp-moe-stream",
      "type": "git-cmake",
      "repo": "https://github.com/npanj/llama.cpp.git",
      "ref": "f507d75f8dfeb90ad96c3e6a08129dbb1999d17a",
      "path": "deps/llama.cpp-moe-stream",
      "build_dir": "deps/llama.cpp-moe-stream/build",
      "target": "llama-server",
      "binary": "deps/llama.cpp-moe-stream/build/bin/llama-server",
      "cmake_args": [
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "require_gpu": true,
      "enabled_env": "LLAMACPP_MOE_STREAM_ENABLED"
    },
    {
      "name": "ninfer-3090",
      "type": "git-cmake",
      "repo": "https://github.com/ashalliants/ninfer-3090.git",
      "ref": "d2dd8e70e51955cd408f19b4514a1db78e79f07f",
      "path": "deps/ninfer-3090",
      "build_dir": "deps/ninfer-3090/build-sm86",
      "target": "ninfer-serve",
      "binary": "deps/ninfer-3090/build-sm86/apps/ninfer-serve",
      "cmake_args": [
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_CUDA_ARCHITECTURES=86",
        "-DNINFER_BUILD_APPS=ON",
        "-DBUILD_TESTING=OFF",
        "-DNINFER_BUILD_BENCHMARKS=OFF"
      ],
      "cuda_toolchain": true,
      "verify_help": true,
      "enabled_env": "NINFER_ENABLED"
    }
  ]
}
