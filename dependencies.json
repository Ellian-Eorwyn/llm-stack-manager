{
  "version": 1,
  "dependencies": [
    {
      "name": "llama.cpp",
      "type": "git-cmake",
      "repo": "https://github.com/ggml-org/llama.cpp.git",
      "ref": "7e4c0a96880dae4fc4268ad441f8a6446bd5460a",
      "path": "deps/llama.cpp",
      "patches": [
        "patches/llama.cpp/0001-json-object-implies-an-object-schema.patch"
      ],
      "build_dir": "deps/llama.cpp/build",
      "target": "llama-server",
      "binary": "deps/llama.cpp/build/bin/llama-server",
      "cmake_args": [
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "require_gpu": true
    },
    {
      "name": "honcho",
      "type": "git-uv",
      "repo": "https://github.com/plastic-labs/honcho.git",
      "ref": "main",
      "path": "deps/honcho",
      "uv_args": [
        "sync",
        "--frozen",
        "--no-group",
        "dev"
      ],
      "enabled_env": "HONCHO_ENABLED"
    }
  ]
}
