# =============================================================================
# LLM Stack Configuration
# Generated from the active local stack. Copy to llm-stack.env and edit.
STACK_DIR=@STACK_DIR@
LISTEN_HOST=0.0.0.0
# Edit this file to change model paths, ports, GPU assignments, and launch flags.
# All four services source this file at startup.
# After editing, restart the affected service(s):
#   sudo systemctl restart llm-a llm-a-proxy embed rerank
# =============================================================================

# -----------------------------------------------------------------------------
# Binary path
# Points to the llama-server binary built from llama.cpp.
# -----------------------------------------------------------------------------
LLAMA_SERVER_BIN=@STACK_DIR@/deps/llama.cpp/build/bin/llama-server

# -----------------------------------------------------------------------------
# Model paths
# Update these to point to the actual downloaded GGUF files.
#
# The two chat backend slots are configured here. They are peers: `llm-a` and
# `llm-b` are separate backends on their own ports, each with its own proxy
# trio, and neither falls back to the other.
# -----------------------------------------------------------------------------

# Primary backend slot.
LLM_A_LABEL="LLM A"
LLM_A_MODEL_NAME=chat-dense
LLM_A_MODEL_PATH=@STACK_DIR@/models/Qwen3.6-27B-uncensored-heretic-v2-Native-MTP-Preserved-Q6_K.gguf
LLM_A_MMPROJ_PATH=@STACK_DIR@/models/Qwen3.6-27B-uncensored-heretic-v2-Native-MTP-Preserved-Q6_K.mmproj.gguf
LLM_A_CTX_SIZE=32768

# Secondary backend slot — used by llm-b and llm-b-proxy.
LLM_B_MODEL_NAME=chat-custom2
LLM_B_MODEL_PATH=@STACK_DIR@/models/Qwen3.5-27B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf
LLM_B_MMPROJ_PATH=@STACK_DIR@/models/mmproj-Qwen3.5-27B-Uncensored-HauhauCS-Aggressive-f16.gguf
LLM_B_CTX_SIZE=262144

# The older spellings of these keys are still *read* for backward compatibility
# (see LEGACY_ENV_KEY_MAP), but they are deliberately not shipped here any more.
# Writing them into a fresh config put a second, never consulted copy of every
# backend identity in the file — install.sh matches on literal key names, so it
# re-added them after every migration, and the stale copies drifted until they
# named different model files than the running ones.
#
# That was fixed for CHAT_DENSE_* and CHAT_MOE_* and then reintroduced by the
# next rename: CHAT_SECONDARY_* sat below naming a 35B MoE while LLM_B_* above
# named a 27B dense, and the bare CHAT_* block below carried a whole second copy
# of slot A's tuning. Only LLM_B_* and LLM_A_* were ever read.

# Embedding model:
EMBEDDING_MODEL_PATH=@STACK_DIR@/models/Qwen3-Embedding-0.6B-Q8_0.gguf
# Example:
# EMBEDDING_MODEL_PATH=@STACK_DIR@/models/Qwen3-Embedding-0.6B-Q8_0.gguf

# Reranker model:
RERANKER_MODEL_PATH=@STACK_DIR@/models/Qwen3-Reranker-0.6B.Q8_0.gguf
# Example:
# RERANKER_MODEL_PATH=@STACK_DIR@/models/Qwen3-Reranker-0.6B-Q8_0.gguf

# Small task model (fast responses, low VRAM):
TASK_MODEL_PATH=@STACK_DIR@/models/Qwen3.5-4B-UD-Q4_K_XL.gguf
TASK_MMPROJ_PATH=@STACK_DIR@/models/Qwen3.5-4B-UD-Q4_K_XL.gguf
TASK_MODEL_NAME=task

# -----------------------------------------------------------------------------
# Chat model launch flags, per slot: LLM_A_* for llm-a, LLM_B_* for llm-b
# -----------------------------------------------------------------------------

# Number of parallel request slots (controls how many requests can run at once).
LLM_A_N_PARALLEL=1
LLM_B_N_PARALLEL=1

# Cache-aware pi-forge scheduling reserves two llama.cpp slots: slot 0 for
# interactive requests and slot 1 for background work. `--ctx-size` is the
# total KV context shared by all slots, so 262144 total tokens provides roughly
# 131072 tokens per slot when LLM_*_N_PARALLEL=2. The stack-manager UI preset
# writes explicit LLM_A_* values for the primary backend and LLM_B_*
# values for the secondary backend:
#   LLM_A_N_PARALLEL=2       LLM_B_N_PARALLEL=2
#   LLM_A_CTX_SIZE=262144    LLM_B_CTX_SIZE=262144
#   LLM_A_CACHE_RAM=8192     LLM_B_CACHE_RAM=8192
#   LLM_A_CTX_CHECKPOINTS=8  LLM_B_CTX_CHECKPOINTS=8
#   LLM_A_CACHE_IDLE_SLOTS=on LLM_B_CACHE_IDLE_SLOTS=on
#   LLM_A_FIT=off            LLM_B_FIT=off
# Pi-forge's connectedServices.chat.scheduling toggle remains configured in
# ~/.pi-forge/agent/settings.json; this environment file only configures the
# llama.cpp deployment.

# How to place weights across GPUs.
# Valid values:
#   none   = keep the model on one GPU chosen by the slot's MAIN_GPU
#   layer  = split by layers across GPUs (the dependable multi-GPU choice)
#   tensor = experimental tensor+KV parallelism across GPUs
#
# "row" is no longer accepted: the CUDA split-buffer implementation was removed
# upstream, so llama-server refuses to load the model. "tensor" also needs a
# non-hybrid architecture, which rules out the whole Qwen3.5/3.8 family; the
# launcher checks the model and falls back to "layer" with a reason in the
# journal. See docs/gpu-split-modes.md.
LLM_A_SPLIT_MODE=layer
LLM_B_SPLIT_MODE=layer

# Tensor split ratio between GPU 0 and GPU 1, used by split-mode=layer.
# "1,1" = equal split. Adjust if one GPU has more free VRAM.
# Example: "3,2" would put 60% on GPU 0 and 40% on GPU 1.
# Ignored by split-mode none and tensor.
LLM_A_TENSOR_SPLIT=1
LLM_B_TENSOR_SPLIT=1

# Number of GPU layers to offload. -1 = offload everything possible.
LLM_A_N_GPU_LAYERS=-1
LLM_B_N_GPU_LAYERS=-1

# Optional llama.cpp device override for model offload placement.
# Leave empty to use all visible CUDA devices. Use --list-devices names, e.g. "CUDA0,CUDA1" or "none".
LLM_A_DEVICE=CUDA0
LLM_B_DEVICE=CUDA0

# Whether KV cache pages should be offloaded to GPU memory when supported.
# Valid values: on, off
LLM_A_KV_OFFLOAD=on
LLM_B_KV_OFFLOAD=on

# Whether host tensor operations should be offloaded to device when supported.
# Valid values: on, off
LLM_A_OP_OFFLOAD=on
LLM_B_OP_OFFLOAD=on

# Whether the multimodal projector should be GPU-offloaded when loaded.
# Valid values: on, off
LLM_A_MMPROJ_OFFLOAD=on
LLM_B_MMPROJ_OFFLOAD=on

LLM_A_MAIN_GPU=0
LLM_B_MAIN_GPU=0

# Flash attention. Reduces VRAM usage for long contexts. Requires GPU.
# Valid values: on, off, auto
LLM_A_FLASH_ATTN=on
LLM_B_FLASH_ATTN=on

# KV cache quantization. q8_0 cuts KV cache VRAM roughly in half vs f16.
# Valid values: f32, f16, bf16, q8_0, q5_0, q5_1, q4_0, q4_1, iq4_nl
# Set both to f16 to disable quantization entirely.
LLM_A_CACHE_TYPE_K=q8_0
LLM_B_CACHE_TYPE_K=q8_0
LLM_A_CACHE_TYPE_V=q8_0
LLM_B_CACHE_TYPE_V=q8_0

# Server prompt-cache RAM in MiB and context checkpoints. Set either to 0 to disable.
#
# Checkpoints are the expensive knob, and how expensive depends on the model.
# On a hybrid-attention model every checkpoint carries the full recurrent state
# — around 150 MiB for a 27B, before a single token is stored — so 32
# checkpoints across 2 slots can want several times the RAM CACHE_RAM allows,
# and the cache then evicts multi-GiB entries on most requests. 8 is a floor
# that fits a 32 GB host; ask the manager for a figure derived from your own
# model and memory rather than trusting this one:
#
#   python3 web/budget.py --backend llm-a
#   GET /api/backend/budget/recommend
LLM_A_CACHE_RAM=8192
LLM_B_CACHE_RAM=8192
LLM_A_CTX_CHECKPOINTS=8
LLM_B_CTX_CHECKPOINTS=8
LLM_A_CACHE_IDLE_SLOTS=on
LLM_B_CACHE_IDLE_SLOTS=on
# Reuse chunk size for partial prefix matches, so an edit mid-prompt reprocesses
# the tail instead of the whole conversation. 0 leaves the llama.cpp default.
LLM_A_CACHE_REUSE=256
LLM_B_CACHE_REUSE=256
LLM_A_SWA_FULL=off
LLM_B_SWA_FULL=off

# Memory mapping. "true" loads the full model into RAM at startup (no page faults).
LLM_A_NO_MMAP=true
LLM_B_NO_MMAP=true

# Memory locking. "true" prevents the OS from swapping model weights to disk.
LLM_A_MLOCK=true
LLM_B_MLOCK=true

# CPU thread counts. -1 lets llama.cpp choose automatically.
LLM_A_THREADS=-1
LLM_B_THREADS=-1
LLM_A_THREADS_BATCH=-1
LLM_B_THREADS_BATCH=-1

# Prefill batch sizes. Larger = faster prompt processing, more VRAM during prefill.
LLM_A_BATCH_SIZE=2048
LLM_B_BATCH_SIZE=2048
LLM_A_UBATCH_SIZE=512
LLM_B_UBATCH_SIZE=512

# Sampling parameters for chat models.
LLM_A_TEMP=1.0
LLM_B_TEMP=1.0
LLM_A_TOP_P=0.95
LLM_B_TOP_P=0.95
LLM_A_TOP_K=20
LLM_B_TOP_K=20
LLM_A_MIN_P=0.00
LLM_B_MIN_P=0.00

# Native tool calling via Jinja2 templates (--jinja flag).
# Enables OpenAI-compatible tool/function calling in chat completions.
# Valid values: on, off
LLM_A_JINJA=on
LLM_B_JINJA=on

# Optional custom Jinja template from config/chat-templates/<id>.jinja.
# Leave empty to use the template embedded in the model metadata.
LLM_A_TEMPLATE_ID=""
LLM_B_TEMPLATE_ID=""

# Reasoning format — how thinking/reasoning content is returned in API responses.
# Valid values: none, deepseek, deepseek-legacy
#   none:            leaves thoughts in message.content
#   deepseek:        puts thoughts in message.reasoning_content
#   deepseek-legacy: keeps <think> tags + reasoning_content
LLM_A_REASONING_FORMAT=deepseek
LLM_B_REASONING_FORMAT=deepseek

# Preserve reasoning traces across conversation history via chat_template_kwargs.
# Valid values: on, off
LLM_A_PRESERVE_THINKING=on
LLM_B_PRESERVE_THINKING=on

# Backend default thinking level for templates that read reasoning_effort
# (Qwen 3.8+). Valid values: xhigh, medium, low, or empty to leave the template's
# own default alone. The proxy overrides this per endpoint, so this is only what
# a request reaching the backend directly will see.
LLM_A_REASONING_EFFORT=
LLM_B_REASONING_EFFORT=

# Auto-fit model to device memory. When "on", llama-server may reduce context size
# to fit in VRAM. Set to "off" to enforce the configured context size exactly.
# Valid values: on, off
LLM_A_FIT=off
LLM_B_FIT=off
LLM_A_FIT_TARGET=""
LLM_B_FIT_TARGET=""
LLM_A_FIT_CTX=4096
LLM_B_FIT_CTX=4096

# Speculative decoding / assisted decoding using a smaller draft GGUF.
# Leave disabled unless the draft model shares a compatible tokenizer and
# actually improves acceptance rate for your target model.
LLM_A_SPEC_METHOD=draft-mtp
LLM_B_SPEC_METHOD=draft-mtp
LLM_A_SPEC_NGRAM_MOD=off
LLM_B_SPEC_NGRAM_MOD=off
LLM_A_SPEC_DRAFT_MODEL_PATH=""
LLM_B_SPEC_DRAFT_MODEL_PATH=""
LLM_A_SPEC_DRAFT_N_GPU_LAYERS=auto
LLM_B_SPEC_DRAFT_N_GPU_LAYERS=auto
LLM_A_SPEC_DRAFT_DEVICES=""
LLM_B_SPEC_DRAFT_DEVICES=""
LLM_A_SPEC_DRAFT_TYPE_K=f16
LLM_B_SPEC_DRAFT_TYPE_K=f16
LLM_A_SPEC_DRAFT_TYPE_V=f16
LLM_B_SPEC_DRAFT_TYPE_V=f16
LLM_A_SPEC_DRAFT_N_MAX=3
LLM_B_SPEC_DRAFT_N_MAX=3
LLM_A_SPEC_DRAFT_N_MIN=0
LLM_B_SPEC_DRAFT_N_MIN=0
LLM_A_SPEC_DRAFT_P_MIN=0.75
LLM_B_SPEC_DRAFT_P_MIN=0.75
LLM_A_SPEC_DRAFT_P_SPLIT=0.10
LLM_B_SPEC_DRAFT_P_SPLIT=0.10
LLM_A_SPEC_NGRAM_MOD_N_MATCH=24
LLM_B_SPEC_NGRAM_MOD_N_MATCH=24
LLM_A_SPEC_NGRAM_MOD_N_MIN=48
LLM_B_SPEC_NGRAM_MOD_N_MIN=48
LLM_A_SPEC_NGRAM_MOD_N_MAX=64
LLM_B_SPEC_NGRAM_MOD_N_MAX=64
LLM_A_SPEC_NGRAM_SIZE_N=12
LLM_B_SPEC_NGRAM_SIZE_N=12
LLM_A_SPEC_NGRAM_SIZE_M=48
LLM_B_SPEC_NGRAM_SIZE_M=48
LLM_A_SPEC_NGRAM_MIN_HITS=1
LLM_B_SPEC_NGRAM_MIN_HITS=1

# Prefix log lines with timestamp and service name.
LLM_A_LOG_PREFIX=true
LLM_A_METRICS=on
LLM_B_LOG_PREFIX=true
LLM_B_METRICS=on

# Which GPUs are visible to the chat services (comma-separated device indices).
LLM_A_GPU_VISIBLE_DEVICES=0
LLM_B_GPU_VISIBLE_DEVICES=0

# Internal backend ports and hosts. Each backend binds here (localhost only)
# and its proxy exposes the thinking/chat/code ports in front of it.
#
# These keep the pre-rename spelling on purpose: they are the port contract, the
# half of the wiring the proxies dial by name, and section 2.1 freezes them.
# `CHAT_*` here is llm-a and `CHAT2_*` is llm-b -- nowhere else in this file.
CHAT_BACKEND_HOST=127.0.0.1
CHAT_BACKEND_PORT=8010
CHAT2_BACKEND_PORT=8020

# Proxy-to-backend socket timeouts.
# Keep connect bounded so dead backends fail fast.
# Disable the read timeout so long-running coding/chat turns are not cut off.
BACKEND_CONNECT_TIMEOUT_SEC=10
BACKEND_READ_TIMEOUT_SEC=off

# -----------------------------------------------------------------------------
# Embedding model launch flags
# -----------------------------------------------------------------------------
EMBED_N_GPU_LAYERS=-1
EMBED_CTX_SIZE=8192
EMBED_N_PARALLEL=1
EMBED_THREADS=-1
EMBED_THREADS_BATCH=-1
EMBED_SPLIT_MODE=layer
EMBED_TENSOR_SPLIT=1
EMBED_FLASH_ATTN=on
EMBED_CACHE_TYPE_K=f16
EMBED_CACHE_TYPE_V=f16
EMBED_BATCH_SIZE=2048
EMBED_UBATCH_SIZE=512
EMBED_NO_MMAP=true
EMBED_MLOCK=true

# GPU device for the embedding model (single GPU).
EMBED_GPU_VISIBLE_DEVICES=0

# Sampling / formatting controls (kept in parity with chat settings).
EMBED_TEMP=1.0
EMBED_TOP_P=0.95
EMBED_TOP_K=20
EMBED_MIN_P=0.00
EMBED_JINJA=off
EMBED_REASONING_FORMAT=none
EMBED_FIT=off

# Prefix log lines with timestamp and service name.
EMBED_LOG_PREFIX=true
EMBED_METRICS=on

# -----------------------------------------------------------------------------
# Secondary Embedding backend
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Reranker model launch flags
# -----------------------------------------------------------------------------
RERANK_N_GPU_LAYERS=-1
RERANK_CTX_SIZE=8192
RERANK_N_PARALLEL=1
RERANK_THREADS=-1
RERANK_THREADS_BATCH=-1
RERANK_SPLIT_MODE=layer
RERANK_TENSOR_SPLIT=1
RERANK_FLASH_ATTN=on
RERANK_CACHE_TYPE_K=f16
RERANK_CACHE_TYPE_V=f16
RERANK_BATCH_SIZE=4096
RERANK_UBATCH_SIZE=512
RERANK_NO_MMAP=false
RERANK_MLOCK=false

# GPU device for the reranker model (single GPU).
# Pin to GPU 1 so it doesn't compete with the embedding model on GPU 0.
RERANK_GPU_VISIBLE_DEVICES=0

# Sampling / formatting controls (kept in parity with chat settings).
RERANK_TEMP=1.0
RERANK_TOP_P=0.95
RERANK_TOP_K=20
RERANK_MIN_P=0.00
RERANK_JINJA=off
RERANK_REASONING_FORMAT=none
RERANK_FIT=off

# Prefix log lines with timestamp and service name.
RERANK_LOG_PREFIX=true
RERANK_METRICS=on

# -----------------------------------------------------------------------------
# Task model launch flags (small fast model, single GPU)
# -----------------------------------------------------------------------------

# Native tool calling via Jinja2 templates (--jinja flag).
# Valid values: on, off
TASK_JINJA=on

# Enable thinking/reasoning for task model.
# Valid values: on, off
TASK_THINKING=on

# Custom chat template, named by id rather than by path: the file is read from
# config/chat-templates/<id>.jinja. Leave empty to use the model's own template.
TASK_CHAT_TEMPLATE_ID=

# Reasoning format — how thinking/reasoning content is returned in API responses.
# Valid values: none, deepseek, deepseek-legacy
TASK_REASONING_FORMAT=deepseek

# Thinking level for templates that read reasoning_effort (Qwen 3.8+).
# Valid values: xhigh, medium, low. Only applies when TASK_THINKING=on.
TASK_REASONING_EFFORT=low

# Auto-fit model to device memory. When "on", llama-server may reduce context size
# to fit in VRAM. Set to "off" to enforce the configured context size exactly.
# Valid values: on, off
TASK_FIT=off
TASK_FIT_TARGET=""
TASK_FIT_CTX=4096

TASK_N_GPU_LAYERS=-1
TASK_MAIN_GPU=0
TASK_DEVICE=""
TASK_CTX_SIZE=32000
TASK_N_PARALLEL=1
TASK_THREADS=-1
TASK_THREADS_BATCH=-1
TASK_SPLIT_MODE=layer
TASK_TENSOR_SPLIT=1
TASK_KV_OFFLOAD=on
TASK_OP_OFFLOAD=on
TASK_MMPROJ_OFFLOAD=on
TASK_BATCH_SIZE=2048
TASK_UBATCH_SIZE=512
TASK_FLASH_ATTN=on
TASK_CACHE_TYPE_K=q8_0
TASK_CACHE_TYPE_V=q8_0
TASK_CACHE_RAM=8192
TASK_CTX_CHECKPOINTS=8
TASK_CACHE_IDLE_SLOTS=on
TASK_CACHE_REUSE=256
TASK_SWA_FULL=off

# Memory mapping and locking for task model.
TASK_NO_MMAP=false
TASK_MLOCK=false

# Sampling parameters for task model.
TASK_TEMP=.7
TASK_TOP_P=0.95
TASK_TOP_K=20
TASK_MIN_P=0.00
TASK_PRESENCE_PENALTY=0.00
TASK_REPEAT_PENALTY=1.00

TASK_CUSTOM_ARGS_JSON="[]"

# -----------------------------------------------------------------------------
# LoRA adapters for the task model
# Adapter GGUFs live in models/loras/ and are applied on top of the base model
# at runtime -- nothing is merged, so one base serves every fine-tune of it.
#
# TASK_LORA_PATHS is a comma-separated list; a bare name is resolved under
# models/loras/, an absolute path is used as given. TASK_LORA_SCALES pairs
# with it positionally; a missing entry means 1.0.
#
# TASK_LORA_INIT_WITHOUT_APPLY=on (the default) launches every listed adapter at
# scale 0 so none is applied until you pick one from the Services page, which
# takes effect without restarting the backend. Set it off to have them all apply
# at their configured scale from startup -- note that they then stack.
#
# "Scale 0" is emitted as `--lora-scaled <path>:0`, not left to the
# --lora-init-without-apply flag: llama-server re-applies each task's adapter
# set from the configured scales, so only a configured 0 actually holds. See
# docs/lora-adapters.md.
# -----------------------------------------------------------------------------
TASK_LORA_PATHS=""
TASK_LORA_SCALES=""
TASK_LORA_INIT_WITHOUT_APPLY=on


# Speculative decoding / assisted decoding for the task model.
# Same options as LLM_A_SPEC_* but independent for the task service.
TASK_SPEC_METHOD=off
TASK_SPEC_NGRAM_MOD=off
TASK_SPEC_DRAFT_MODEL_PATH=""
TASK_SPEC_DRAFT_N_GPU_LAYERS=auto
TASK_SPEC_DRAFT_DEVICES=""
TASK_SPEC_DRAFT_TYPE_K=f16
TASK_SPEC_DRAFT_TYPE_V=f16
TASK_SPEC_DRAFT_N_MAX=6
TASK_SPEC_DRAFT_N_MIN=0
TASK_SPEC_DRAFT_P_MIN=0.75
TASK_SPEC_DRAFT_P_SPLIT=0.10
TASK_SPEC_NGRAM_MOD_N_MATCH=24
TASK_SPEC_NGRAM_MOD_N_MIN=48
TASK_SPEC_NGRAM_MOD_N_MAX=64
TASK_SPEC_NGRAM_SIZE_N=12
TASK_SPEC_NGRAM_SIZE_M=48
TASK_SPEC_NGRAM_MIN_HITS=1

TASK_LOG_PREFIX=true
TASK_METRICS=on

# GPU device for the task model. Defaults to GPU 0; change if load is uneven.
TASK_GPU_VISIBLE_DEVICES=0

# -----------------------------------------------------------------------------
# OCR model launch flags (GLM-OCR multimodal backend)
# -----------------------------------------------------------------------------
OCR_MODEL_PATH=@STACK_DIR@/models/GLM-OCR-F16.gguf
OCR_MMPROJ_PATH=""
OCR_MODEL_NAME=ocr
OCR_HOST=${LISTEN_HOST}
OCR_PORT=8009
OCR_CTX_SIZE=8192
OCR_N_PARALLEL=1
OCR_THREADS=-1
OCR_THREADS_BATCH=-1
OCR_N_GPU_LAYERS=-1
OCR_MAIN_GPU=0
OCR_DEVICE=""
OCR_SPLIT_MODE=layer
OCR_TENSOR_SPLIT=auto
OCR_KV_OFFLOAD=on
OCR_OP_OFFLOAD=on
OCR_MMPROJ_OFFLOAD=on
OCR_BATCH_SIZE=2048
OCR_UBATCH_SIZE=512
OCR_FLASH_ATTN=on
OCR_CACHE_TYPE_K=f16
OCR_CACHE_TYPE_V=f16
OCR_NO_MMAP=false
OCR_MLOCK=false
# OCR_GPU_VISIBLE_DEVICES controls which GPUs the OCR llama-server can see.
# Use 0 or 1 for one GPU, or 0,1 with OCR_SPLIT_MODE=layer to split across both.
OCR_GPU_VISIBLE_DEVICES=0
OCR_PROMPT="OCR"
OCR_TEMP=0.1
OCR_TOP_P=0.95
OCR_TOP_K=1
OCR_MIN_P=0.00
OCR_FIT=off
OCR_LOG_PREFIX=true
OCR_METRICS=on
OCR_CUSTOM_ARGS_JSON="[]"
# Must cover a cold model load, not just inference, when the router is on.
OCR_TIMEOUT_SECONDS=600

# -----------------------------------------------------------------------------
# Model router — on-demand loading for the auxiliary models
# -----------------------------------------------------------------------------
# When on, one llama-server in router mode owns embed/ocr/rerank/task instead of
# one systemd unit each. Models load on first request and evict each other, so
# the tier shares one VRAM budget rather than holding four static reservations.
# Callers keep using EMBED_PORT/RERANK_PORT/TASK_PORT/OCR_PORT; nginx fronts
# those onto MODEL_ROUTER_PORT, and the router picks the model from the request
# body. Off leaves every service exactly as it is today.
MODEL_ROUTER_ENABLED=off
MODEL_ROUTER_PORT=8013
# Loopback on purpose: nginx fronts the per-model ports and proxies here, so
# binding this to the LAN would only add a second unauthenticated way in.
MODEL_ROUTER_HOST=127.0.0.1
# A count, not a memory budget. The router evicts least-recently-used but does
# not know how large the survivors are, so size this against your free VRAM.
# 1 gives strict one-model-at-a-time.
MODEL_ROUTER_MAX=2
MODEL_ROUTER_MEMBERS=EMBED,OCR,RERANK,TASK
# Unload a resident model's weights and KV after this much idleness; the next
# request reloads it. -1 disables.
MODEL_ROUTER_SLEEP_IDLE_SECONDS=600
# Every pooled model inherits this, so per-model placement uses real device
# indices in its own *_MAIN_GPU / *_TENSOR_SPLIT.
MODEL_ROUTER_GPU_VISIBLE_DEVICES=0,1

# -----------------------------------------------------------------------------
# GLM-OCR SDK document parser (local/self-hosted, no MaaS/cloud OCR calls)
# -----------------------------------------------------------------------------
GLMOCR_SDK_ENABLED=on
GLMOCR_SDK_HOST=${LISTEN_HOST}
GLMOCR_SDK_PORT=5002
GLMOCR_PUBLIC_URL=http://127.0.0.1:5002/glmocr/parse
GLMOCR_SDK_LOG_LEVEL=INFO
GLMOCR_OCR_API_MODE=openai
GLMOCR_OCR_API_URL=""
# A read timeout, and the binding constraint on OCR: it has to cover a cold
# model load as well as the inference. Connecting is never the problem, since
# something is always listening, so the connect timeout stays short.
GLMOCR_OCR_REQUEST_TIMEOUT=600
# Not a socket timeout. The SDK's startup probe is a real inference POST,
# retried until this expires; with the model router that first POST is what
# loads the OCR model, so it has to outlast a cold load.
GLMOCR_OCR_CONNECT_TIMEOUT=300
GLMOCR_OCR_RETRY_MAX_ATTEMPTS=4
GLMOCR_OCR_RETRY_BACKOFF_BASE_SECONDS=0.5
GLMOCR_OCR_RETRY_BACKOFF_MAX_SECONDS=30
GLMOCR_OCR_CONNECTION_POOL_SIZE=128
GLMOCR_MAX_WORKERS=16
GLMOCR_PAGE_MAXSIZE=100
GLMOCR_REGION_MAXSIZE=800
GLMOCR_PAGE_MAX_TOKENS=8192
GLMOCR_PAGE_TEMPERATURE=0.0
GLMOCR_PAGE_TOP_P=0.00001
GLMOCR_PAGE_TOP_K=1
GLMOCR_PAGE_REPETITION_PENALTY=1.1
GLMOCR_IMAGE_FORMAT=JPEG
GLMOCR_MIN_PIXELS=12544
GLMOCR_MAX_PIXELS=71372800
GLMOCR_PDF_DPI=200
GLMOCR_PDF_MAX_PAGES=""
GLMOCR_LAYOUT_MODEL_DIR=PaddlePaddle/PP-DocLayoutV3_safetensors
GLMOCR_LAYOUT_DEVICE=""
GLMOCR_LAYOUT_CUDA_VISIBLE_DEVICES=""
GLMOCR_LAYOUT_THRESHOLD=0.3
GLMOCR_LAYOUT_BATCH_SIZE=1
GLMOCR_LAYOUT_WORKERS=1
GLMOCR_LAYOUT_USE_POLYGON=off
GLMOCR_OUTPUT_FORMAT=both
GLMOCR_MERGE_FORMULA_NUMBERS=on
GLMOCR_MERGE_TEXT_BLOCKS=on
GLMOCR_FORMAT_BULLET_POINTS=on
GLMOCR_PROMPT_TEXT="Text Recognition:"
GLMOCR_PROMPT_TABLE="Table Recognition:"
GLMOCR_PROMPT_FORMULA="Formula Recognition:"
GLMOCR_ADVANCED_CONFIG_JSON="{}"
GLMOCR_SDK_VERSION=0.1.5
GLMOCR_PRELOAD_LAYOUT_MODEL=on

# -----------------------------------------------------------------------------
# SearXNG metasearch service
# -----------------------------------------------------------------------------
SEARXNG_ENABLED=on
SEARXNG_BASE_URL=http://127.0.0.1/searxng/
SEARXNG_PUBLIC_URL=http://127.0.0.1/searxng/
SEARXNG_URL_PATH=/searxng
SEARXNG_INSTANCE_NAME="SearXNG"
SEARXNG_SAFE_SEARCH=2
SEARXNG_AUTOCOMPLETE=duckduckgo
SEARXNG_FORMATS=html,json
SEARXNG_LIMITER=false
SEARXNG_IMAGE_PROXY=true
SEARXNG_SECRET=""
SEARXNG_VALKEY_URL=valkey://localhost:6379/0
SEARXNG_HOME=/usr/local/searxng
SEARXNG_SETTINGS_PATH=/etc/searxng/settings.yml
SEARXNG_UWSGI_INI=/etc/uwsgi/apps-available/searxng.ini
SEARXNG_UWSGI_SOCKET=/usr/local/searxng/run/socket
SEARXNG_NGINX_CONF=/etc/nginx/default.apps-available/searxng.conf

# -----------------------------------------------------------------------------
# Playwright browser automation WebSocket server
# -----------------------------------------------------------------------------
PLAYWRIGHT_ENABLED=on
PLAYWRIGHT_HOST=0.0.0.0
PLAYWRIGHT_PORT=3001
PLAYWRIGHT_UPSTREAM_PORT=13001
PLAYWRIGHT_URL_PATH=/playwright
PLAYWRIGHT_PUBLIC_WS_URL=ws://127.0.0.1/playwright/
PLAYWRIGHT_PUBLIC_HTTP_URL=http://127.0.0.1/playwright/
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_INSTALL_BROWSERS=on
PLAYWRIGHT_BROWSERS_PATH=@STACK_DIR@/playwright/browsers
PLAYWRIGHT_NODE_ENV=production
PLAYWRIGHT_NGINX_CONF=/etc/nginx/default.apps-available/playwright.conf

# -----------------------------------------------------------------------------
# Port assignments
# -----------------------------------------------------------------------------
THINK_PORT=8003
NOTHINK_PORT=8004
CODE_PORT=8008
AGGREGATE_ENABLED=on
AGGREGATE_PORT=8012

# Secondary Ports for proxy 2
THINK2_PORT=8103
NOTHINK2_PORT=8104
CODE2_PORT=8108
AGGREGATE2_ENABLED=on
AGGREGATE2_PORT=8112

# Model names advertised by the proxy on /v1/models.
THINK_MODEL_NAME=think
NOTHINK_MODEL_NAME=chat
CODE_MODEL_NAME=code
THINK2_MODEL_NAME=think2
NOTHINK2_MODEL_NAME=chat2
CODE2_MODEL_NAME=code2

# When on, streamed SSE responses are forwarded byte-for-byte after request
# shaping. This avoids proxy-side stream JSON rewriting at the cost of exposing
# upstream streamed model/reasoning fields unchanged.
PROXY_STREAM_PASSTHROUGH=off

# Diagnostic capture of the request payload behind an upstream 400. This writes
# a whole conversation to disk, so it is off by default. When on, captures go to
# ${STACK_DIR}/logs/upstream-400 at mode 0600, newest UPSTREAM_400_CAPTURE_KEEP
# retained, each capped at UPSTREAM_400_CAPTURE_MAX_BYTES.
UPSTREAM_400_CAPTURE_ENABLED=off
UPSTREAM_400_CAPTURE_DIR=
UPSTREAM_400_CAPTURE_KEEP=5
UPSTREAM_400_CAPTURE_MAX_BYTES=262144

EMBED_MODEL_NAME=embed
RERANK_MODEL_NAME=rank

# Proxy endpoint configuration (all three endpoints share the same backend model).
# Chat always forces thinking off.
# Thinking always forces thinking on.
# Code uses CODE_THINKING and CODE_* request overrides.
CODE_THINKING=on
CODE_JINJA=on
CODE_CTX_SIZE=262144
CODE_N_PARALLEL=1
CODE_THREADS=-1
CODE_THREADS_BATCH=-1
CODE_N_GPU_LAYERS=-1
CODE_SPLIT_MODE=layer
CODE_TENSOR_SPLIT=1
CODE_FLASH_ATTN=on
CODE_CACHE_TYPE_K=q8_0
CODE_CACHE_TYPE_V=q8_0
CODE_BATCH_SIZE=4096
CODE_UBATCH_SIZE=512
CODE_NO_MMAP=true
CODE_MLOCK=true
CODE_GPU_VISIBLE_DEVICES=0
CODE_TEMP=0.6
CODE_MAX_TOKENS=0
CODE_TOP_P=0.95
CODE_TOP_K=20
CODE_MIN_P=0.00
CODE_REASONING_FORMAT=deepseek
CODE_FIT=off

EMBED_PORT=8005
RERANK_PORT=8006
TASK_PORT=8007

# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Web manager
# -----------------------------------------------------------------------------
LLM_MANAGER_PORT=8077
LLM_MANAGER_HOST=0.0.0.0

# How often the manager checks whether the installed stack is behind its git
# remote, in seconds. The check runs on a background thread and caches its
# result, so the UI never waits on it. A local comparison alone is not enough:
# the cached origin ref goes stale, and a stale ref reports "up to date" no
# matter how far behind the tree actually is — so this does fetch. Set to 0 to
# disable the check entirely; the minimum otherwise is 60.
LLM_MANAGER_DEPLOY_CHECK_INTERVAL=900


# -----------------------------------------------------------------------------
# Read-only state API
# -----------------------------------------------------------------------------
# A second listener, in the manager's process, serving live stack state to other
# applications: GPU utilisation and per-model VRAM, context use across slots,
# service health, backend log events, and alerts with stable codes. JSON,
# server-sent events, Prometheus and webhooks, from one snapshot.
#
# It exists as its own port because the manager's port cannot be shared. Port
# 8077 runs as root, can start and stop services, and serves an endpoint that
# returns every API key in this file. This one has no route that writes
# anything — the mutating routes are not registered on it — which is what makes
# it safe to point at from another machine.
LLM_API_ENABLED=on

# 127.0.0.1 keeps it on this box. Set 0.0.0.0 for the LAN, or a Tailscale
# address (`tailscale ip -4`) to reach it over the tailnet and nowhere else.
LLM_API_HOST=127.0.0.1
LLM_API_PORT=8078

# Blank means no authentication, which is the default and is fine on a trusted
# tailnet. Set it and every request must carry `Authorization: Bearer <token>`,
# or `?token=` for the event stream — browsers cannot set headers on an
# EventSource. Binding to a non-loopback address with this blank is allowed, and
# is reported at startup and in /api/v1/alerts rather than being silently done.
LLM_API_TOKEN=

# Comma-separated origins allowed to read this from a browser page. Blank sends
# no CORS headers at all, which is what you want unless a web app needs it.
LLM_API_ALLOW_ORIGINS=

# How often the event stream collects, in seconds (1-60). One collector serves
# every connected client, so this is the cost of the stream regardless of how
# many applications are watching. A client may ask for a faster cadence with
# ?interval= and the loop runs at the fastest anything connected asked for.
LLM_API_STREAM_INTERVAL=2

# Optional push instead of poll. On a service state change or an alert, POST the
# event to this URL. Signed with X-LLM-Stack-Signature (HMAC-SHA256 over the
# body, keyed by LLM_API_TOKEN) when a token is set. Blank disables it.
LLM_API_WEBHOOK_URL=
LLM_API_WEBHOOK_EVENTS=service_state,alert


# -----------------------------------------------------------------------------
# Control API (write)
# -----------------------------------------------------------------------------
# The other half of the state API, on a third port. It can edit this file, apply
# a saved profile, and start or stop a service -- so it is off unless you turn it
# on, and it refuses to bind to anything but loopback without a token.
#
# Two tokens rather than one, deliberately: reading the stack's state and
# stopping its backends are different blast radii, and the read token is the one
# you hand out. Use different values.
LLM_CONTROL_ENABLED=off
LLM_CONTROL_HOST=127.0.0.1
LLM_CONTROL_PORT=8079
LLM_CONTROL_TOKEN=
# Whether a remote controller may write API keys and tokens here. Secrets are
# never readable back through this API either way -- you can set one, you cannot
# fetch one.
LLM_CONTROL_ALLOW_SECRETS=off


# -----------------------------------------------------------------------------
# pi-forge integration
# -----------------------------------------------------------------------------
# Where pi-forge keeps its agent directory, which holds the inference-lease
# files that coordinate slot 0 (interactive) against slot 1 (background). Blank
# means <stack owner's home>/.pi-forge/agent, which is right on a normal
# install; the manager runs as root, so it cannot just look in its own home.
PI_FORGE_AGENT_DIR=

# Whether the manager may delete leases whose writing process is gone. Off by
# default: that directory belongs to pi-forge. Either way the Reap button in the
# Cache-Aware Scheduling panel does the same thing on request, and neither path
# touches a lease that is fresh or whose process is still alive.
PI_FORGE_LEASE_REAP=off


# -----------------------------------------------------------------------------
# Per-slot persona tuning
# -----------------------------------------------------------------------------
# The THINK_*, NOTHINK_* and CODE_* settings below are shared by both proxies.
# Prefix any of them with the slot to override it for one proxy only:
#
#   THINK_TEMP=0.7          both slots, as before
#   LLM_B_THINK_TEMP=0.2    slot B's thinking endpoint only
#
# The shared key stays the fallback, so a host that has never set a prefixed one
# behaves exactly as it did. Applies to every suffix in
# `web/backends/proxies.py:PERSONA_SUFFIXES` -- temperature, top-p, top-k,
# min-p, penalties, reasoning format, reasoning effort, max tokens and the
# streaming mode -- plus CODE_THINKING.
#
# Ports and aliases are NOT tunable this way: THINK2_PORT and THINK2_MODEL_NAME
# carry the contract in docs/pi-forge-scheduling-contract.md, and that is frozen.

# -----------------------------------------------------------------------------
# Memory Gateway (inside llm-a-proxy)
# -----------------------------------------------------------------------------
# Graphiti is not installed by the v1 core repo. Keep this off unless you add a
# compatible memory service and point MEMORY_GRAPHITI_BASE_URL at it.
MEMORY_GATEWAY_ENABLED=off
MEMORY_ENABLE_THINK=on
MEMORY_ENABLE_NOTHINK=on
MEMORY_ENABLE_CODE=off
MEMORY_GRAPHITI_BASE_URL=http://127.0.0.1:8070
MEMORY_GRAPHITI_TIMEOUT_SEC=0.35
MEMORY_GRAPHITI_COOLDOWN_SEC=30
MEMORY_INJECTION_MODE=system
MEMORY_MAX_FACTS=8
MEMORY_MAX_FACT_CHARS=220
MEMORY_MAX_BLOCK_CHARS=1800
MEMORY_MAX_QUERY_MESSAGES=6
MEMORY_INCLUDE_SYSTEM_IN_QUERY=off
MEMORY_MAX_INGEST_CHARS=4000
MEMORY_GROUP_HEADER_PRIORITY=x-conversation-id,x-session-id,x-chat-id,x-openwebui-chat-id
MEMORY_GROUP_FALLBACK_SALT=llm-stack
MEMORY_FAIL_OPEN=on

NOTHINK_PRESERVE_THINKING=off
NOTHINK_REASONING_STREAM_MODE=hidden

NOTHINK_JINJA=on

NOTHINK_REASONING_FORMAT=deepseek

NOTHINK_TEMP=0.7
NOTHINK_MAX_TOKENS=0

NOTHINK_TOP_P=0.95

NOTHINK_TOP_K=20

NOTHINK_MIN_P=0.00

LLM_A_CUSTOM_ARGS_JSON="[]"

# -----------------------------------------------------------------------------
# LoRA adapters for LLM A
# Adapter GGUFs live in models/loras/ and are applied on top of the base model
# at runtime -- nothing is merged, so one base serves every fine-tune of it.
#
# LLM_A_LORA_PATHS is a comma-separated list; a bare name is resolved under
# models/loras/, an absolute path is used as given. LLM_A_LORA_SCALES pairs
# with it positionally; a missing entry means 1.0.
#
# LLM_A_LORA_INIT_WITHOUT_APPLY=on (the default) launches every listed adapter at
# scale 0 so none is applied until you pick one from the Services page, which
# takes effect without restarting the backend. Set it off to have them all apply
# at their configured scale from startup -- note that they then stack.
#
# "Scale 0" is emitted as `--lora-scaled <path>:0`, not left to the
# --lora-init-without-apply flag: llama-server re-applies each task's adapter
# set from the configured scales, so only a configured 0 actually holds. See
# docs/lora-adapters.md.
# -----------------------------------------------------------------------------
LLM_A_LORA_PATHS=""
LLM_A_LORA_SCALES=""
LLM_A_LORA_INIT_WITHOUT_APPLY=on

LLM_B_CUSTOM_ARGS_JSON="[]"

# -----------------------------------------------------------------------------
# LoRA adapters for LLM B
# Adapter GGUFs live in models/loras/ and are applied on top of the base model
# at runtime -- nothing is merged, so one base serves every fine-tune of it.
#
# LLM_B_LORA_PATHS is a comma-separated list; a bare name is resolved under
# models/loras/, an absolute path is used as given. LLM_B_LORA_SCALES pairs
# with it positionally; a missing entry means 1.0.
#
# LLM_B_LORA_INIT_WITHOUT_APPLY=on (the default) launches every listed adapter at
# scale 0 so none is applied until you pick one from the Services page, which
# takes effect without restarting the backend. Set it off to have them all apply
# at their configured scale from startup -- note that they then stack.
#
# "Scale 0" is emitted as `--lora-scaled <path>:0`, not left to the
# --lora-init-without-apply flag: llama-server re-applies each task's adapter
# set from the configured scales, so only a configured 0 actually holds. See
# docs/lora-adapters.md.
# -----------------------------------------------------------------------------
LLM_B_LORA_PATHS=""
LLM_B_LORA_SCALES=""
LLM_B_LORA_INIT_WITHOUT_APPLY=on


THINK_TEMP=0.7
THINK_MAX_TOKENS=0

THINK_TOP_P=0.95

THINK_TOP_K=20

THINK_MIN_P=0.00

THINK_REASONING_FORMAT=deepseek

THINK_JINJA=on

THINK_PRESERVE_THINKING=on
# Where reasoning is reported. This changes only where it is reported, not what
# it costs — the tokens are generated either way.
#   hidden = reasoning_content only, and content carries just the answer. If the
#            reply produced no answer at all (truncated mid-thought), the
#            reasoning is surfaced as content rather than returning nothing.
#   mirror = reasoning_content, and the same text also streams into content.
#   content = visible content only; reasoning_content is discarded. Streaming
#            clients see the whole chain of thought before the answer.
THINK_REASONING_STREAM_MODE=hidden

# Thinking level, for templates that read reasoning_effort (Qwen 3.8+).
# Valid values: xhigh, medium, low, or empty to leave the template's own default
# in place. Only applies where thinking is on, and only under a template that
# reads it — older Qwen templates silently ignore it.
#   xhigh  = the template adds "think carefully, validate assumptions" steering
#   medium = no steering instruction at all; the model's unsteered baseline
#   low    = the template adds "keep your thinking brief" steering
# A client sending an OpenAI level (high, minimal) is mapped onto the nearest of
# these by the proxy, because the template raises rather than degrading. This is
# a default, not a ceiling: a request carrying its own reasoning_effort wins,
# and reasoning_effort "none" turns thinking off for that one request.
THINK_REASONING_EFFORT=medium

CODE_PRESERVE_THINKING=on
CODE_REASONING_STREAM_MODE=hidden
CODE_REASONING_EFFORT=medium

THINK_PRESENCE_PENALTY=0.00

THINK_REPEAT_PENALTY=1.00

NOTHINK_PRESENCE_PENALTY=0.00

NOTHINK_REPEAT_PENALTY=1.00

CODE_PRESENCE_PENALTY=0.00

CODE_REPEAT_PENALTY=1.00

# -----------------------------------------------------------------------------
# Transcription (speech-to-text sidecar)
# -----------------------------------------------------------------------------
# A Python sidecar, not a llama-server. It hosts the ASR runtimes that llama.cpp
# cannot: faster-whisper (Whisper large-v3, turbo, distil), NeMo (Parakeet v3,
# Canary-Qwen) and plain transformers for anything else you download. Install the
# runtimes you want with:  bash scripts/install-transcribe.sh --engines nemo,hf
#
# Off by default and bound to loopback: an upgrade should not start putting audio
# on the network on your behalf. Set the host to a Tailscale address to let other
# machines reach it.
TRANSCRIPT_ENABLED=off
TRANSCRIPT_HOST=127.0.0.1
TRANSCRIPT_PORT=8014
# Blank means no authentication. Set it and requests need Authorization: Bearer.
TRANSCRIPT_API_TOKEN=
TRANSCRIPT_PUBLIC_URL=http://127.0.0.1:8014
TRANSCRIPT_ACTIVE_ENGINE=faster-whisper
# Comma-separated --engines tokens that install-transcribe.sh set up here.
TRANSCRIPT_ENGINES=faster-whisper
# Must cover a cold model load, not just the decode: the first request after an
# idle unload is what pulls the weights back onto the GPU.
TRANSCRIPT_TIMEOUT_SECONDS=600
TRANSCRIPT_LOCAL_DEVICE=cuda
TRANSCRIPT_LOCAL_COMPUTE_TYPE=float16
TRANSCRIPT_DEFAULT_FORMAT=json
TRANSCRIPT_LOG_LEVEL=INFO

# How transcription shares VRAM with the pooled router models.
#
# One transcription model is resident at a time, and it is dropped this many
# seconds after its last use, so it does not sit on the GPU beside embed, OCR,
# rank and task. 0 or -1 keeps it resident.
TRANSCRIPT_IDLE_UNLOAD_SECONDS=300
# Unload router models before loading a local one, so the two never stack:
#   asr = drop only the pooled audio model (the default)
#   all = drop every model the router currently holds
#   off = do not touch the router
TRANSCRIPT_ROUTER_YIELD=asr
# The router engine forwards to llama.cpp, which returns prose with no timeline
# at all. Off refuses srt/vtt/verbose_json on that engine rather than emitting a
# fabricated one; on returns a single whole-file cue marked "degraded": true.
TRANSCRIPT_ROUTER_ALLOW_DEGRADED=off
# 1 is correct for a single resident model, and NeMo is not thread-safe.
TRANSCRIPT_MAX_CONCURRENCY=1

TRANSCRIPT_MAX_UPLOAD_MB=512
# Audio longer than this returns a job id from /transcribe instead of holding
# the connection open. /v1/audio/transcriptions never goes async: an OpenAI SDK
# cannot poll, so it returns 413 pointing at /transcribe instead.
TRANSCRIPT_ASYNC_THRESHOLD_SECONDS=900
TRANSCRIPT_JOB_TTL_SECONDS=3600
# Comma-separated hosts /transcribe may fetch audio from. Blank denies every
# fetch, which is the default because this process can reach the whole tailnet.
TRANSCRIPT_URL_ALLOW_HOSTS=

# Per-engine slots. BACKEND_TYPE=local runs the model here; upstream forwards to
# another OpenAI-compatible server. LOCAL_MODEL takes preset:<name> or
# local:<absolute-path>.
FASTER_WHISPER_BACKEND_TYPE=local
FASTER_WHISPER_LOCAL_MODEL=preset:large-v3
PARAKEET_V3_BACKEND_TYPE=local
PARAKEET_V3_LOCAL_MODEL=preset:nvidia/parakeet-tdt-0.6b-v3
CANARY_QWEN_BACKEND_TYPE=local
CANARY_QWEN_LOCAL_MODEL=preset:nvidia/canary-qwen-2.5b
HF_ASR_BACKEND_TYPE=local
HF_ASR_LOCAL_MODEL=
# Forwards to llama-router, where the audio GGUF is pooled with embed/ocr/rank/
# task. The model name is the models.ini section name the router serves it under.
ROUTER_ASR_BACKEND_TYPE=local
ROUTER_ASR_LOCAL_MODEL=preset:asr

# The audio GGUF the router pools. Only read when ASR is in
# MODEL_ROUTER_MEMBERS, e.g. MODEL_ROUTER_MEMBERS=EMBED,OCR,RERANK,TASK,ASR.
# llama.cpp refuses transcription unless the model carries an audio projector,
# so ASR_MMPROJ_PATH is not optional here — see docs/transcription.md.
ASR_MODEL_NAME=asr
ASR_MODEL_PATH=
ASR_MMPROJ_PATH=
ASR_CTX_SIZE=32768
ASR_N_GPU_LAYERS=-1
ASR_JINJA=on
ASR_GPU_VISIBLE_DEVICES=0

# --- Apple silicon MLX runtime ----------------------------------------------
# Which process serves a slot. `llamacpp` is the llama-server launcher used
# everywhere; `mlx` is the Apple silicon native path and is only meaningful on
# a Mac. Note that TRANSCRIPT_ENGINE selects the *server*, where
# TRANSCRIPT_ACTIVE_ENGINE above selects the runtime inside the sidecar server.
EMBED_ENGINE=llamacpp
TRANSCRIPT_ENGINE=sidecar

# The MLX services run from their own virtualenv. The manager depends on
# nothing but Flask and is kept that way deliberately, so the mlx / fastapi /
# uvicorn tree lives apart from it and an MLX upgrade cannot take the
# management UI down. Created by scripts/install-mlx-runtime.sh.
MLX_RUNTIME_VENV=@STACK_DIR@/deps/mlx-runtime-venv
MLX_RUNTIME_PYTHON=python3
MLX_HF_HOME=@STACK_DIR@/models/.cache/huggingface

# Local model directories, pinned by revision in config/mlx-models.lock.json.
MLX_EMBED_MODEL_PATH=@STACK_DIR@/models/mlx/Qwen3-Embedding-0.6B-4bit-DWQ
MLX_PARAKEET_MODEL_PATH=@STACK_DIR@/models/mlx/parakeet-tdt-0.6b-v3
MLX_PARAKEET_MODEL_NAME=parakeet-v3-en

# Parakeet v3's checkpoint is multilingual; this endpoint accepts English only
# and rejects other language values rather than transcribing them badly.
# Chunking keeps peak memory predictable on a small unified-memory machine.
MLX_PARAKEET_CHUNK_SECONDS=60
MLX_PARAKEET_OVERLAP_SECONDS=5
