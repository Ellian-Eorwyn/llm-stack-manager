+def _normalize_extracted_entities_payload(llm_response: Any) -> dict[str, Any]:
+    """
+    Normalize common local-model JSON shapes to ExtractedEntities schema.
+
+    Expected shape:
+      {"extracted_entities":[{"name":"...", "entity_type_id":0}, ...]}
+
+    Common observed variants:
+      [{"entity":"...", "entity_type_id":0}]
+      {"entities":[{"entity":"...", "entity_type_id":0}]}
+      {"extracted_entities":[{"entity":"...", "entity_type_id":0}]}
+    """
+    if isinstance(llm_response, dict):
+        if isinstance(llm_response.get('extracted_entities'), list):
+            candidates = llm_response['extracted_entities']
+        elif isinstance(llm_response.get('entities'), list):
+            candidates = llm_response['entities']
+        elif isinstance(llm_response.get('entity_nodes'), list):
+            candidates = llm_response['entity_nodes']
+        else:
+            # Preserve original payload to let pydantic raise a precise error for unknown shapes.
+            return llm_response
+    elif isinstance(llm_response, list):
+        candidates = llm_response
+    else:
+        return {'extracted_entities': []}
+
+    normalized: list[dict[str, Any]] = []
+    for item in candidates:
+        if not isinstance(item, dict):
+            continue
+        name = item.get('name')
+        if not isinstance(name, str) or not name.strip():
+            entity_name = item.get('entity')
+            if isinstance(entity_name, str) and entity_name.strip():
+                name = entity_name
+        if not isinstance(name, str) or not name.strip():
+            entity_text = item.get('entity_text')
+            if isinstance(entity_text, str) and entity_text.strip():
+                name = entity_text
+        if not isinstance(name, str) or not name.strip():
+            value = item.get('value')
+            if isinstance(value, str) and value.strip():
+                name = value
+        if not isinstance(name, str) or not name.strip():
+            continue
+
+        type_id = item.get('entity_type_id', 0)
+        if not isinstance(type_id, int):
+            try:
+                type_id = int(type_id)
+            except (TypeError, ValueError):
+                type_id = 0
+
+        normalized.append({'name': name.strip(), 'entity_type_id': type_id})
+
+    if isinstance(llm_response, dict) and llm_response.get('extracted_entities') == normalized:
+        return llm_response
+    logger.warning(
+        'Normalized non-standard ExtractedEntities payload shape from LLM output '
+        '(keys=%s, normalized_count=%d)',
+        list(llm_response.keys()) if isinstance(llm_response, dict) else type(llm_response).__name__,
+        len(normalized),
+    )
+    return {'extracted_entities': normalized}
+
