# Runtime configuration and local state
/config/llm-stack.env
# Copies of the env file, however they were made. The installed stack is a
# checkout, so a backup left beside the original is an untracked file inside it
# -- which is the one condition update.sh refuses to run under. Backing up the
# config must not cost you the ability to update.
/config/llm-stack.env.bak*
/config/llm-stack.env.devbak
/config/honcho.env
/config/custom-models.json
# Peer addresses and their credentials. Per-install state, never committed.
/config/fleet.json
/config/custom-model-arg-presets.json
/config/saved/
/config/chat-templates/
/config/*-state.json
/config/tts-*.json

# Large or generated dependencies
/deps/
/models/
/downloads/
/exports/
/logs/
/backups/
/hermes/
/playwright/node_modules/
/playwright/logs/

# Local patch sets that are not ours to publish. patches/hermes-agent and
# patches/llama.cpp are committed on purpose -- they are patches against public
# upstreams. This one is a rendered Frigate config carrying camera credentials
# and a LAN address, and this repository is public.
/patches/frigate/

# Python/runtime artifacts
.venv/
.test-venv/
*/.venv/
__pycache__/

# Unsloth writes a compiled-trainer cache into the working directory the
# moment it is imported, so running scripts/finetune/train.py from the
# repo root drops 3.5 MB of generated trainer subclasses here.
unsloth_compiled_cache/
*.py[cod]
.pytest_cache/

# llama.cpp and build output
/build/
/CMakeCache.txt
/CMakeFiles/

# Local editor/system files
.DS_Store
._*
*.swp
*.swo

# Generated local config/state
/config/default-saved-config
/config/glmocr-sdk.json
# The transcription sidecar's config, rendered from the env keys on every start
# by scripts/start-transcribe.sh. Same reasoning as models.ini below.
/config/transcribe.json
# The model router's preset, rendered from the env keys on every service start
# by scripts/render-models-ini.py. Committing it would put a build artefact in
# the tree, and — because the installed stack is a checkout — every router start
# would dirty it and make update.sh refuse to run.
/config/models.ini
# Kept empty on purpose: it is LLAMA_CACHE for the router, pointed away from the
# real one so that only the preset decides which models are routable.
/config/model-router-cache/
# The launchd plists and wrapper scripts install.sh generates on macOS, one per
# installed service. Per-install state like the env file beside them -- and
# leaving them untracked made every macOS install permanently dirty, which is
# the exact condition update.sh refuses to run under. The installer's own output
# broke the update command the installer's own output recommends.
/scripts/launchd-wrapper-*.sh
/config/launchd/

# Which services this box is meant to be running. Recorded by the manager as
# they are started and stopped, so it is per-install state, not configuration.
/config/service-expectations.json
