# Runtime configuration and local state
/config/llm-stack.env
/config/honcho.env
/config/custom-models.json
/config/custom-model-arg-presets.json
/config/saved/
/config/chat-templates/
/config/*-state.json
/config/tts-*.json

# Large or generated dependencies
/deps/
/models/
/downloads/
/exports/
/logs/
/backups/
/hermes/
/playwright/node_modules/
/playwright/logs/

# Python/runtime artifacts
.venv/
.test-venv/
*/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# llama.cpp and build output
/build/
/CMakeCache.txt
/CMakeFiles/

# Local editor/system files
.DS_Store
._*
*.swp
*.swo

# Generated local config/state
/config/default-saved-config
/config/glmocr-sdk.json
# The model router's preset, rendered from the env keys on every service start
# by scripts/render-models-ini.py. Committing it would put a build artefact in
# the tree, and — because the installed stack is a checkout — every router start
# would dirty it and make update.sh refuse to run.
/config/models.ini
# Kept empty on purpose: it is LLAMA_CACHE for the router, pointed away from the
# real one so that only the preset decides which models are routable.
/config/model-router-cache/
# Which services this box is meant to be running. Recorded by the manager as
# they are started and stopped, so it is per-install state, not configuration.
/config/service-expectations.json
