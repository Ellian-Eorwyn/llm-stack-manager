Documentation=file:///mnt/LLMs/llamacpp/llm-stack-git/docs/voice-tts.md
After=network-online.target

[Service]
Environment=CUDA_VISIBLE_DEVICES=0
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_OFFLINE=1
ExecStart=/home/ellie/AI/voice-tts/venv/bin/python /mnt/LLMs/llamacpp/llm-stack-git/scripts/voice-tts-server.py --host 100.124.56.11 --port 8016
