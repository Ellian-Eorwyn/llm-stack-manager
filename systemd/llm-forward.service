# Install on llms: sudo cp systemd/llm-forward.nginx.conf /etc/nginx/llm-forward.conf
#                  sudo cp systemd/llm-forward.service /etc/systemd/system/
#                  sudo systemctl enable --now llm-forward
[Unit]
Description=Forward llms 8005/8006 (embed, rerank) to the Studio
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStartPre=/usr/sbin/nginx -t -q -c /etc/nginx/llm-forward.conf
ExecStart=/usr/sbin/nginx -c /etc/nginx/llm-forward.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /etc/nginx/llm-forward.conf -s reload
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
